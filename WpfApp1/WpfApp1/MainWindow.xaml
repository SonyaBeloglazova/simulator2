<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор муравья" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,10,0">
            <GroupBox Header="Размер поля" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Ширина:" Width="70" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtWidth" Width="60" Text="20"/>
                        <TextBlock Text=" (5-50)" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Высота:" Width="70" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHeight" Width="60" Text="20"/>
                        <TextBlock Text=" (5-50)" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            
            <GroupBox Header="Начальная позиция муравья" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="X:" Width="30" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtStartX" Width="60" Text=""/>
                            <TextBlock Text=" (пусто = случайно)" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Y:" Width="30" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtStartY" Width="60" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            <GroupBox Header="Правила: белая клетка" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <ComboBox x:Name="CmbWhiteAction" Margin="0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Button Content="Добавить" Width="90" Margin="0,0,5,0"/>
                        <Button Content="Удалить" Width="90"/>
                    </StackPanel>
                    <ListBox x:Name="ListWhiteActions" Height="80" Margin="0,5"/>
                </StackPanel>
            </GroupBox>
            
            <GroupBox Header="Правила: чёрная клетка" Margin="0,0,0,10" Padding="5">
                    <StackPanel>
                        <ComboBox x:Name="CmbBlackAction" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Button Content="Добавить" Width="90" Margin="0,0,5,0"/>
                            <Button Content="Удалить" Width="90"/>
                        </StackPanel>
                        <ListBox x:Name="ListBlackActions" Height="80" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Button x:Name="BtnGenerate" Content="Сгенерировать" Width="100" Margin="0,0,5,0" Padding="5"/>
                    <Button x:Name="BtnStart" Content="Запустить" Width="90" Margin="0,0,5,0" Padding="5"/>
                    <Button x:Name="BtnPause" Content="Пауза" Width="80" Padding="5" IsEnabled="False"/>
                </StackPanel>

            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="#F5F5F5">
            <Canvas x:Name="FieldCanvas" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
